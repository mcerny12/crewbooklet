# Supabase — public, browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only, NEVER prefix with NEXT_PUBLIC_
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# App URL — used for auth redirects and email links
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
